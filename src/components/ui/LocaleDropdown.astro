---
import { localeLabels, localeNames, useUI, type Locale } from "@/i18n";
import { pageContext } from "@utils/seo";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { alternates } = pageContext(Astro, locale);
const t = useUI(locale);
---

<button
  type="button"
  class="locale-trigger"
  popovertarget="navbar-locale-options"
>
  <span class="visually-hidden">{t.menu.language}:</span>
  {localeLabels[locale]}
  <span class="locale-chevron" aria-hidden="true"></span>
</button>

<nav
  id="navbar-locale-options"
  class="locale-options"
  aria-label={t.menu.language}
  popover="auto"
>
  {alternates.map(({ locale: option, path }) => (
    <a
      href={path}
      lang={option}
      hreflang={option}
      aria-current={option === locale ? "page" : undefined}
    >
      {localeNames[option]}
    </a>
  ))}
</nav>

<style>
  .locale-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    margin-block: -4px;
    padding: 4px 0;
    min-height: 24px;
  }

  .locale-chevron {
    transform: rotate(45deg);
    margin-block-start: -0.2em;
    border-inline-end: 1px solid;
    border-block-end: 1px solid;
    width: 0.4em;
    height: 0.4em;
  }

  .locale-trigger:has(+ :popover-open) .locale-chevron {
    transform: rotate(225deg);
    margin-block-start: 0.2em;
  }

  .locale-options {
    --panel-width: min(11rem, calc(100% - 24px));
    position: fixed;
    inset: auto;
    top: var(--locale-top, 4rem);
    left: clamp(
      12px,
      var(--locale-left, 100%),
      calc(100% - 12px - var(--panel-width))
    );
    margin: 0;
    border: 1px solid var(--color-divider);
    border-radius: 6px;
    background-color: var(--color-bg-primary);
    padding: 4px;
    width: var(--panel-width);
    color: var(--color-text-primary);
    font-size: 1rem;
    text-transform: none;
  }

  .locale-options a {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-radius: 3px;
    padding: 8px 10px;
  }

  .locale-options a:hover,
  .locale-options a:focus-visible,
  .locale-options [aria-current="page"] {
    background-color: var(--color-bg-overlay);
  }

  .locale-options [aria-current="page"]::after {
    border-radius: 50%;
    background-color: var(--color-divider);
    width: 6px;
    height: 6px;
    content: "";
  }

  @supports not selector(:popover-open) {
    .locale-trigger,
    .locale-options {
      display: none;
    }
  }
</style>

<script>
  const trigger = document.querySelector(".locale-trigger");
  const panel = document.getElementById("navbar-locale-options");
  if (trigger && panel?.showPopover) {
    const position = () => {
      const { left, bottom } = trigger.getBoundingClientRect();
      panel.style.setProperty("--locale-left", `${left}px`);
      panel.style.setProperty("--locale-top", `${bottom + 8}px`);
    };
    panel.addEventListener("beforetoggle", (event) => {
      if (event.newState === "open") position();
    });
    window.addEventListener("resize", () => {
      if (panel.matches(":popover-open")) position();
    });
  }
</script>
